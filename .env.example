# Copy to .env in the repo root. Do not commit .env.
# nasa-client is published on 4016. nasa-api is published on 4017.
# 3002 is left free because stateanalytica already uses it on the home server.

MONGO_USER=nasa
MONGO_PASSWORD=replace-with-a-long-random-string
NASA_API_KEY=DEMO_KEY
INGEST_TOKEN=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:4016,http://127.0.0.1:4016,https://nasa.everettdeleon.com
NEXT_PUBLIC_API_URL=http://localhost:4017
